# Arquivo de variáveis de ambiente para o container api-rust-core no Droplet (/opt/apps/.env.rust)
PORT=8000
RUST_LOG=info,api_rust_core=info

# Conexão com o MongoDB Atlas (Tier M0 Sandbox - Banco CNU preservando coleções existentes)
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@cluster1.c1b9e6c.mongodb.net/?retryWrites=true&w=majority&appName=Cluster1
MONGODB_DB=CNU

# Chaves de IA (Tutores sob demanda com cache persistente em todasQuestoes)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# Segredo JWT para sessões do App Android Kotlin
JWT_SECRET=gere_uma_string_aleatoria_forte_para_producao

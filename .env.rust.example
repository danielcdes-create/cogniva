PORT=8000
RUST_LOG=info,api_rust_core=info
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority
MONGODB_DB=CNU
# Set securely on the server. The application refuses an empty/short JWT secret.
JWT_SECRET=
# Explicit account IDs authorized to administer; empty grants no admin rights.
ADMIN_USER_IDS=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provider model IDs are configurable; an unavailable provider never becomes a fake tutor.
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini-2024-07-18
APK_STORAGE_PATH=/app/apk/current/cogniva.apk
APK_METADATA_PATH=/app/apk/current/output-metadata.json

2026-11-01T19:47:22.8119185Z   script: adb shell wm size 1440x3088
adb shell wm density 500
adb shell cmd overlay enable com.android.internal.display.cutout.emulation.hole
adb shell cmd overlay list | tr -d '\r' | grep -E '\[x\].*com\.android\.internal\.display\.cutout\.emulation\.hole'
adb shell wm size | tr -d '\r' | grep 1440x3088
adb shell wm density | tr -d '\r' | grep 500
echo PROFILE_RESOLUTION report=Android17/API35 booted_release=$(adb shell getprop ro.build.version.release | tr -d '\r') booted_sdk=$(adb shell getprop ro.build.version.sdk | tr -d '\r')
echo Android 17 is API 37. API 35 is Android 15. Booting the report numeric API at S23 Ultra geometry.
echo EMULATOR_BOOTED $(adb shell getprop ro.build.version.release | tr -d '\r') $(adb shell getprop ro.build.version.sdk | tr -d '\r') $(adb shell wm size | tr -d '\r') $(adb shell wm density | tr -d '\r') punch-hole=hole
cd android-app && chmod +x gradlew && ./gradlew :app:connectedDebugAndroidTest -PDO_API_BASE_URL=https://127.0.0.1:1/api/v1/ -Pandroid.testInstrumentationRunnerArguments.class=br.com.concursoprep.app.QuestionInsetCollisionTest,br.com.concursoprep.app.DurableStorageTest --no-daemon --console=plain
sleep 2
adb logcat -d -s INSET_CHECK:I
adb logcat -d | tr -d '\r' | grep -E 'INSET_CHECK.*success'


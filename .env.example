# Configuração unificada de ambiente — cogniva-api (2.0.0)
# Copie para .env (desenvolvimento local) ou /opt/apps/.env.rust (produção, chmod 600).

# Persistência MongoDB (obrigatório em produção)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=cogniva

# Endereço interno de escuta HTTP e telemetria
BIND_ADDRESS=0.0.0.0:8000
RUST_LOG=info,cogniva_api=info

# Segurança de sessão (mínimo 32 bytes aleatórios; gere com: openssl rand -hex 32)
JWT_SECRET=TROQUE_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES
COGNIVA_PUBLIC_ORIGIN=https://198.199.65.103

# Bootstrap automático de administradores (e-mails separados por vírgula)
ADMIN_EMAILS=admin@exemplo.com

# Provedor de IA (xAI) — quando XAI_API_KEY estiver definida, XAI_MODEL é obrigatório
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_DAILY_GLOBAL_LIMIT=500
XAI_DAILY_USER_LIMIT=120

# Distribuição OTA do APK assinado
APK_STORAGE_PATH=/app/apk/current/cogniva.apk
APK_METADATA_PATH=/app/apk/current/output-metadata.json

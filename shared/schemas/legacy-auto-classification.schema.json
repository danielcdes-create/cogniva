{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogniva.local/schemas/legacy-auto-classification/1",
  "title": "Finite legacy automatic classification extension; never human confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "cohort_id",
    "status",
    "operation_id",
    "content_revision",
    "catalog_version",
    "links",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "const": "legacy-618-auto/1"
    },
    "cohort_id": {
      "const": "legacy-618/2026-11-02"
    },
    "status": {
      "const": "AUTO_APPLIED"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^legacy-auto:[0-9a-f]{24}$"
    },
    "content_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_version": {
      "const": 1
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "topic_id",
          "role",
          "coverage",
          "rationale",
          "confidence"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "topic_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "role": {
            "enum": [
              "PRIMARY",
              "SECONDARY"
            ]
          },
          "coverage": {
            "enum": [
              "DIRECT",
              "CONTEXTUAL"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "confidence": {
            "type": "number",
            "minimum": 0.9,
            "maximum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "AI"
            },
            "id": {
              "enum": ["grok-4.3", "grok-4.7"]
            }
          }
        },
        "method": {
          "const": "AI_AUTOMATIC_LEGACY"
        },
        "model": {
          "enum": ["grok-4.3", "grok-4.7"]
        },
        "prompt_id": {
          "const": "classify-question"
        },
        "prompt_version": {
          "const": "2"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_suggestion_id": {
          "type": "string",
          "format": "uuid"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "method",
        "model",
        "prompt_id",
        "prompt_version",
        "prompt_sha256",
        "source_suggestion_id",
        "recorded_at",
        "rationale"
      ]
    }
  }
}